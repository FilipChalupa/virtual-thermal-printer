{
	"name": "escpos-decoder",
	"version": "0.1.0",
	"description": "Streaming decoder that turns raw ESC/POS bytes into typed text, command and image blocks",
	"keywords": [
		"escpos",
		"esc/pos",
		"thermal-printer",
		"receipt-printer",
		"pos",
		"epson",
		"decoder",
		"parser",
		"stream"
	],
	"license": "MIT",
	"author": "Filip Chalupa",
	"homepage": "https://github.com/FilipChalupa/virtual-thermal-printer/tree/main/packages/escpos-decoder#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FilipChalupa/virtual-thermal-printer.git",
		"directory": "packages/escpos-decoder"
	},
	"bugs": {
		"url": "https://github.com/FilipChalupa/virtual-thermal-printer/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./types": {
			"source": "./src/types.ts",
			"import": "./dist/types.js",
			"types": "./dist/types.d.ts"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"bwip-js": "^4.11.4",
		"iconv-lite": "^0.6.3",
		"pngjs": "^7.0.0",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"@types/pngjs": "^6.0.5",
		"@types/qrcode": "^1.5.5",
		"typescript": "^5.7.3",
		"vitest": "^2.1.8"
	}
}
